---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SocialLinks from './SocialLinks.astro';
import ThemedButton from '@/components/theme/ThemedButton.astro';
import profileImage from '@/assets/images/profile.jpg';
---

<section class="relative pt-24 pb-16 lg:pt-28 lg:pb-20 overflow-hidden">
  <div class="absolute inset-0 hero-halo pointer-events-none"></div>

  <div class="container mx-auto max-w-5xl px-6 relative">
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-center">
      <!-- Photo with refined decorative elements -->
      <div class="relative flex-shrink-0 group">
        <div class="absolute -inset-8 rounded-full border border-foreground/10 hidden sm:block">
        </div>
        <div
          class="relative w-48 h-48 lg:w-60 lg:h-60 rounded-full ring-1 ring-white/12 shadow-[0_35px_80px_rgba(0,0,0,0.6)] overflow-hidden bg-card/40 transition-transform duration-700 group-hover:scale-[1.02]"
        >
          <Image
            src={profileImage}
            alt="Refik Can MALLI"
            width={240}
            height={240}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="eager"
          />
        </div>
      </div>

      <!-- Info with staggered reveal -->
      <div class="space-y-5 text-center lg:text-left flex-1 stagger-children">
        <div class="space-y-3">
          <h1
            class="font-display text-4xl sm:text-5xl lg:text-[3.2rem] font-medium tracking-tight leading-tight"
          >
            Refik Can <span class="font-semibold">MALLI</span>
          </h1>
          <p class="text-foreground/70 text-base lg:text-lg">
            Deep Learning & Agentic AI & Computer Vision
          </p>
        </div>

        <div
          class="flex items-center justify-center lg:justify-start gap-2 text-foreground/60 text-sm"
        >
          <Icon name="hugeicons:location-01" class="w-3.5 h-3.5 text-[color:var(--accent-blue)]" />
          <span>Milan, Italy</span>
        </div>

        <div class="flex flex-wrap justify-center lg:justify-start gap-3 pt-2">
          <ThemedButton
            href="/assets/pdfs/refikcanmalli_cv_20251229.pdf"
            variant="primary"
            icon="hugeicons:file-02"
            external
          >
            View CV
          </ThemedButton>
          <ThemedButton href="/blog" variant="secondary" icon="hugeicons:book-02">
            Read blog
          </ThemedButton>
        </div>

        <div class="flex justify-center lg:justify-start">
          <SocialLinks />
        </div>
      </div>
    </div>
  </div>
</section>
