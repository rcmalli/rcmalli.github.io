---
import { Icon } from 'astro-icon/components';

const education = [
  {
    degree: "Master's Degree",
    field: 'Computer Science Engineering',
    school: 'Politecnico di Milano',
    location: 'Milan, Italy',
    research: 'Adversarial robustness of Deep Neural Networks. Visualization of perturbation-based adversarial attacks and specialized training methods for robust models.',
    supervisors: [
      { name: 'Marco Ciccone', url: 'https://scholar.google.com/citations?user=hOQjblcAAAAJ&hl=en' },
      { name: 'Prof. Matteo Matteucci', url: 'https://scholar.google.com/citations?user=PdbEg5YAAAAJ&hl=en' },
    ],
  },
  {
    degree: "Bachelor's Degree",
    field: 'Electronics and Communication Engineering',
    school: 'Istanbul Technical University',
    location: 'Istanbul, Turkey',
    research: 'Facial attribute extraction using convolutional neural networks. Edge deep learning applications on embedded devices.',
    supervisors: [
      { name: 'Prof. Hazim Kemal Ekenel', url: 'https://scholar.google.com/citations?user=LfIDj68AAAAJ&hl=en' },
    ],
  },
];
---

<section class="py-16 lg:py-24">
  <div class="container mx-auto max-w-5xl px-6">
    <div class="mb-12">
      <h2 class="text-lg lg:text-xl font-light tracking-tight text-muted-foreground">
        Academic Background
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {education.map((edu, i) => (
        <div
          class="group relative p-6 rounded-sm border bg-card/50 border-border/30 hover:border-border/60 hover:shadow-lg hover:shadow-foreground/[0.02] transition-all duration-300 animate-fade-up flex flex-col h-full"
          style={`animation-delay: ${i * 100}ms`}
        >
          <div class="space-y-5 flex-1">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold leading-snug">{edu.degree}</h3>
                <div class="flex items-center gap-1 text-xs text-muted-foreground/60">
                  <Icon name="hugeicons:location-01" class="w-3 h-3" />
                  <span>{edu.location}</span>
                </div>
              </div>
              <p class="text-sm text-muted-foreground">{edu.field}</p>
              <p class="text-sm font-medium text-foreground/70">{edu.school}</p>
            </div>

            <p class="text-sm text-muted-foreground/80 leading-relaxed">
              {edu.research}
            </p>
          </div>

          <div class="text-sm pt-3 border-t border-border/30 mt-auto min-h-[2.5rem] leading-relaxed">
            <span class="text-muted-foreground/60">Supervised by </span>
            {edu.supervisors.map((sup, j) => (
              <>
                <a
                  href={sup.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-foreground/60 hover:text-foreground underline-offset-4 hover:underline transition-colors"
                >
                  {sup.name}
                </a>{j < edu.supervisors.length - 1 && (
                  <span class="text-muted-foreground/50">, </span>
                )}
              </>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
