---
import { cn } from '@/lib/utils';
import { themedLink, type ThemedLinkVariants } from '@/components/ui/themed-variants';

interface Props {
  href: string;
  variant?: ThemedLinkVariants['variant'];
  external?: boolean;
  active?: boolean;
  class?: string;
}

const {
  href,
  variant = 'text',
  external = false,
  active = false,
  class: className = '',
} = Astro.props;

const externalProps = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};

const activeProps = active ? { 'aria-current': 'page' as const } : {};
---

<a href={href} class={cn(themedLink({ variant }), className)} {...externalProps} {...activeProps}>
  <slot />
</a>
