---
import { Icon } from 'astro-icon/components';
import { cn } from '@/lib/utils';
import { themedButton, type ThemedButtonVariants } from '@/components/ui/themed-variants';

interface Props {
  href: string;
  variant?: ThemedButtonVariants['variant'];
  size?: ThemedButtonVariants['size'];
  icon?: string;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'default',
  icon,
  external = false,
  class: className = '',
} = Astro.props;

const externalProps = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a href={href} class={cn(themedButton({ variant, size }), className)} {...externalProps}>
  {icon && <Icon name={icon} class="relative w-4 h-4 transition-transform duration-300 group-hover:scale-110" />}
  <span class="relative"><slot /></span>
</a>
