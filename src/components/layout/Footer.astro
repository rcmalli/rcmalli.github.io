    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="h-px w-20 bg-[color:var(--accent-blue)] opacity-40"></div>

      <p class="text-sm text-foreground/60">
        &copy; {currentYear} Refik Can MALLI. All rights reserved.
      </p>
    </div>
  </div>
</footer>
