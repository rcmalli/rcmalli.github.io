---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border/40 py-12">
  <div class="container mx-auto max-w-5xl px-6">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <!-- Neural node decoration -->
      <div class="flex items-center gap-2 text-muted-foreground">
        <svg viewBox="0 0 60 20" class="h-4 w-16 opacity-50">
          <circle cx="10" cy="10" r="3" fill="currentColor" />
          <circle cx="30" cy="10" r="2" fill="currentColor" />
          <circle cx="50" cy="10" r="3" fill="currentColor" />
          <line x1="13" y1="10" x2="28" y2="10" stroke="currentColor" stroke-width="0.5" />
          <line x1="32" y1="10" x2="47" y2="10" stroke="currentColor" stroke-width="0.5" />
        </svg>
      </div>

      <p class="text-sm text-muted-foreground">
        &copy; {currentYear} Refik Can MALLI. All rights reserved.
      </p>
    </div>
  </div>
</footer>
